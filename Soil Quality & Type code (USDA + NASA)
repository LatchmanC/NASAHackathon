class NASAPOWERClient:
    """Fetches daily/climatology agro-meteorological variables from NASA POWER."""

    BASE_URL = "https://power.larc.nasa.gov/api/temporal/daily/point"

    @classmethod
    def fetch_agroclimate(cls, lat: float, lon: float, days: int = 30) -> Dict[str, Any]:
        end_dt = datetime.now(timezone.utc) - timedelta(days=3)
        start_dt = end_dt - timedelta(days=days)
        params = {
            "parameters": "T2M,T2M_MIN,T2M_MAX,PRECTOTCORR,RH2M,ALLSKY_SFC_SW_DWN,GWETTOP",
            "community": "AG",
            "longitude": round(lon, 4),
            "latitude": round(lat, 4),
            "start": start_dt.strftime("%Y%m%d"),
            "end": end_dt.strftime("%Y%m%d"),
            "format": "JSON",
        }
        try:
            resp = requests.get(cls.BASE_URL, params=params, timeout=HTTP_TIMEOUT)
            resp.raise_for_status()
            props = resp.json().get("properties", {}).get("parameter", {})

            def valid_vals(key: str) -> List[float]:
                return [v for v in props.get(key, {}).values() if v is not None and v > -900]

            t2m = valid_vals("T2M")
            tmin = valid_vals("T2M_MIN")
            tmax = valid_vals("T2M_MAX")
            precip = valid_vals("PRECTOTCORR")
            rh = valid_vals("RH2M")
            solar = valid_vals("ALLSKY_SFC_SW_DWN")
            gwet = valid_vals("GWETTOP")

            avg_temp = round(sum(t2m) / len(t2m), 2) if t2m else 18.0
            total_precip = round(sum(precip), 2) if precip else 65.0
            frost_days = sum(1 for t in tmin if t <= 0.0)
            heat_stress_days = sum(1 for t in tmax if t >= 32.0)
            gdd_base10 = round(sum(max(0.0, t - 10.0) for t in t2m), 1)
            surface_wetness = round(sum(gwet) / len(gwet), 3) if gwet else 0.55

            return {
                "status": "live",
                "window_days": days,
                "mean_temp_c": tagged_metric(
                    avg_temp,
                    "°C",
                    "NASA POWER (MERRA-2)",
                    "remotely_sensed_estimate",
                    "0.5° x 0.625° (~50 km)",
                    "Gridded agroclimatology reanalysis; microclimate topography may vary.",
                ),
                "total_precip_mm": tagged_metric(
                    total_precip,
                    "mm",
                    "NASA POWER / GPM IMERG",
                    "remotely_sensed_estimate",
                    "0.5° grid (~50 km)",
                    f"Cumulative precipitation over past {days} days.",
                ),
                "relative_humidity_pct": round(sum(rh) / len(rh), 1) if rh else 62.0,
                "solar_radiation_mj_m2": round(sum(solar) / len(solar), 2) if solar else 17.5,
                "surface_soil_wetness_index": surface_wetness,
                "frost_days_in_window": frost_days,
                "heat_stress_days_in_window": heat_stress_days,
                "growing_degree_days_base10": gdd_base10,
            }
        except Exception as exc:
            logger.warning("NASA POWER API failed (%s); using climatology fallback.", exc)
            return {
                "status": "fallback",
                "window_days": days,
                "mean_temp_c": tagged_metric(
                    18.5, "°C", "Climatology Fallback", "agronomic_model_prediction", "Regional", str(exc)
                ),
                "total_precip_mm": tagged_metric(
                    70.0, "mm", "Climatology Fallback", "agronomic_model_prediction", "Regional", str(exc)
                ),
                "relative_humidity_pct": 60.0,
                "solar_radiation_mj_m2": 18.0,
                "surface_soil_wetness_index": 0.52,
                "frost_days_in_window": 0,
                "heat_stress_days_in_window": 2,
                "growing_degree_days_base10": 255.0,
            }


