class AgronomicRecommendationEngine:
    """Combines SSURGO, CDL, NASA climate/terrain, and Cropzilla sensors into explainable advice."""

    @classmethod
    def evaluate_field(
        cls,
        field_id: str,
        lat: float,
        lon: float,
        soil: Dict[str, Any],
        crop_history: Dict[str, Any],
        climate: Dict[str, Any],
        terrain: Dict[str, Any],
        sat_layers: Dict[str, Any],
        sensor: Optional[Dict[str, Any]],
    ) -> Dict[str, Any]:
        # Prefer in-situ sensor measurements over mapped survey estimates when present
        effective_ph = (
            sensor["soil_ph"]
            if sensor and sensor.get("soil_ph") is not None
            else soil["ph"]
        )
        ph_source = "Cropzilla In-Situ Sensor" if (sensor and sensor.get("soil_ph") is not None) else "USDA SSURGO"

        effective_moisture_pct = (
            sensor["soil_moisture_pct"]
            if sensor and sensor.get("soil_moisture_pct") is not None
            else round(sat_layers["nasa_smap"]["value"] * 100.0, 1)
        )

        slope_pct = max(terrain["slope_pct"], soil.get("ssurgo_slope_pct", 0.0))
        k_factor = soil.get("erodibility_k_factor", 0.28)
        precip_mm = climate["total_precip_mm"]["value"]

        # RUSLE-inspired relative erosion susceptibility index (0-100)
        erosion_risk_score = min(100.0, round((slope_pct * 4.5) + (k_factor * 65.0) + (precip_mm * 0.12), 1))
        erosion_risk_level = (
            "High" if erosion_risk_score >= 55 else ("Moderate" if erosion_risk_score >= 30 else "Low")
        )

        # Moisture deficit check
        moisture_status = (
            "Drought Stress"
            if effective_moisture_pct < 16.0 or precip_mm < 30.0
            else ("Saturated / Excess" if effective_moisture_pct > 38.0 else "Optimal")
        )

        last_crop = crop_history["history"][-1]["crop"] if crop_history["history"] else "Unknown"
        streak = crop_history.get("monoculture_streak", 0)
        texture = soil["texture_class"]["value"]
        om_pct = soil["organic_matter_pct"]["value"]

        scored_options = []
        for candidate in CROP_KNOWLEDGE_BASE:
            score = 50.0
            reasons: List[str] = []
            cautions: List[str] = []

            # 1. Texture match
            if texture in candidate["ideal_textures"]:
                score += 15.0
                reasons.append(f"Well-suited to mapped {texture} soil texture (SSURGO).")
            else:
                score -= 8.0
                cautions.append(f"{texture} is outside primary texture range; monitor seedbed prep.")

            # 2. pH compatibility
            if candidate["min_ph"] <= effective_ph <= candidate["max_ph"]:
                score += 12.0
                reasons.append(f"Soil pH {effective_ph} ({ph_source}) fits optimal {candidate['min_ph']}-{candidate['max_ph']} window.")
            else:
                score -= 12.0
                cautions.append(f"Soil pH {effective_ph} is suboptimal (target {candidate['min_ph']}-{candidate['max_ph']}).")

            # 3. Moisture & Precipitation fit (NASA POWER / GPM / SMAP)
            if precip_mm >= candidate["min_precip_30d_mm"]:
                score += 10.0
            else:
                if candidate["drought_tolerance"] in ("High", "Very High"):
                    score += 8.0
                    reasons.append(
                        f"Selected for {candidate['drought_tolerance'].lower()} drought resilience given low 30-day rainfall ({precip_mm} mm via NASA POWER/GPM)."
                    )
                else:
                    score -= 15.0
                    cautions.append(f"Recent 30-day precipitation ({precip_mm} mm) is below water demand.")

            # 4. Erosion control bonus on sloped or high-K soils (SRTM + SSURGO)
            if erosion_risk_level in ("Moderate", "High") and candidate["erosion_control_rating"] >= 0.85:
                score += 14.0
                reasons.append(
                    f"High surface cover rating ({int(candidate['erosion_control_rating']*100)}%) mitigates {erosion_risk_level.lower()} erosion risk on {slope_pct}% SRTM slope."
                )

            # 5. Rotation break & Nitrogen replenishment (USDA CDL + Organic Matter)
            if last_crop.lower() in candidate["crop"].lower():
                score -= 25.0
                cautions.append(f"Avoids continuous {last_crop} monoculture (current streak: {streak} yr via USDA CDL).")
            elif last_crop in ("Corn", "Sorghum", "Winter Wheat", "Spring Wheat") and candidate["nitrogen_fixation_kg_ha"] > 0:
                score += 16.0
                reasons.append(
                    f"Breaks cereal rotation after {last_crop} (USDA CDL) and fixes ~{candidate['nitrogen_fixation_kg_ha']} kg N/ha."
                )

            if om_pct < 2.5 and "Cover" in candidate["role"]:
                score += 10.0
                reasons.append(f"Builds soil organic matter (currently {om_pct}% per SSURGO).")

            if "Clay" in texture and candidate["crop"] == "Daikon Tillage Radish":
                score += 12.0
                reasons.append("Deep taproot relieves subsoil compaction in clay-rich horizons.")

            scored_options.append({
                "crop": candidate["crop"],
                "botanical_family": candidate["family"],
                "agronomic_role": candidate["role"],
                "sprite_key": candidate["sprite_key"],
                "suitability_score": max(0, min(100, round(score))),
                "provenance": "agronomic_model_prediction",
                "why_recommended": reasons,
                "risk_cautions": cautions,
                "planting_window_offset_days": candidate["planting_window_offset_days"],
                "days_to_maturity": candidate["days_to_maturity"],
            })

        scored_options.sort(key=lambda x: x["suitability_score"], reverse=True)
        top_pick = scored_options[0]

        # Generate calendar sprite events for FieldShift_v7_Calendar_Sprite frontend
        calendar_events = cls._build_calendar_sprites(field_id, scored_options[:3])

        # Compute & persist Soil Sustainability Score
        sustainability = cls._compute_and_store_sustainability(
            field_id=field_id,
            om_pct=om_pct,
            moisture_status=moisture_status,
            erosion_risk_score=erosion_risk_score,
            monoculture_streak=streak,
            recommended_crop=top_pick["crop"],
        )

        return {
            "water_and_moisture_assessment": {
                "status": moisture_status,
                "effective_soil_moisture_pct": effective_moisture_pct,
                "moisture_source": "Cropzilla ESP32 Probe" if (sensor and sensor.get("soil_moisture_pct") is not None) else "NASA SMAP / POWER Proxy",
                "available_water_capacity_cm_cm": soil["available_water_capacity"]["value"],
            },
            "erosion_assessment": {
                "risk_level": erosion_risk_level,
                "risk_score_0_to_100": erosion_risk_score,
                "slope_pct": slope_pct,
                "ssurgo_k_factor": k_factor,
                "provenance": "agronomic_model_prediction",
            },
            "recommendations": scored_options,
            "calendar_sprite_events": calendar_events,
            "sustainability_tracking": sustainability,
        }

    @staticmethod
    def _build_calendar_sprites(field_id: str, top_crops: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        """Formats recommendations into sprite-compatible calendar entries for FieldShift v7."""
        today = datetime.now(timezone.utc).date()
        events = []
        for idx, rec in enumerate(top_crops):
            plant_date = today + timedelta(days=rec["planting_window_offset_days"] + (idx * 7))
            harvest_date = plant_date + timedelta(days=rec["days_to_maturity"])
            events.append({
                "event_id": f"{field_id}_{rec['sprite_key']}_{plant_date.isoformat()}",
                "field_id": field_id,
                "rank": idx + 1,
                "crop_name": rec["crop"],
                "sprite_id": rec["sprite_key"],
                "stage": "planting_window",
                "start_date": plant_date.isoformat(),
                "expected_termination_or_harvest": harvest_date.isoformat(),
                "suitability_score": rec["suitability_score"],
                "tooltip_summary": rec["why_recommended"][0] if rec["why_recommended"] else rec["agronomic_role"],
            })
        return events

    @staticmethod
    def _compute_and_store_sustainability(
        field_id: str,
        om_pct: float,
        moisture_status: str,
        erosion_risk_score: float,
        monoculture_streak: int,
        recommended_crop: str,
    ) -> Dict[str, Any]:
        om_score = min(100.0, round((om_pct / 4.5) * 100.0, 1))
        moisture_score = 90.0 if moisture_status == "Optimal" else 55.0
        erosion_score = max(0.0, round(100.0 - erosion_risk_score, 1))
        diversity_score = max(20.0, round(100.0 - (max(0, monoculture_streak - 1) * 25.0), 1))

        overall = round((om_score * 0.30) + (moisture_score * 0.25) + (erosion_score * 0.25) + (diversity_score * 0.20), 1)
        now_iso = datetime.now(timezone.utc).isoformat()

        with sqlite3.connect(DB_PATH) as conn:
            conn.execute(
                """
                INSERT INTO sustainability_snapshots (
                    field_id, recorded_at, sustainability_index, organic_matter_score,
                    moisture_stability_score, erosion_protection_score, rotation_diversity_score, recommended_crop
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (field_id, now_iso, overall, om_score, moisture_score, erosion_score, diversity_score, recommended_crop),
            )
            conn.commit()

            cur = conn.execute(
                """
                SELECT recorded_at, sustainability_index, recommended_crop
                FROM sustainability_snapshots
                WHERE field_id = ?
                ORDER BY id DESC LIMIT 10
                """,
                (field_id,),
            )
            trend = [dict(zip(["recorded_at", "sustainability_index", "recommended_crop"], r)) for r in cur.fetchall()]

        return {
            "current_index_0_to_100": overall,
            "subscores": {
                "organic_matter": om_score,
                "moisture_stability": moisture_score,
                "erosion_protection": erosion_score,
                "rotation_diversity": diversity_score,
            },
            "provenance": "agronomic_model_prediction",
            "historical_snapshots": trend,
        }


