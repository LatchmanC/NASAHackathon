# 5. Cropzilla ESP32 In-Situ Sensor Integration
# ---------------------------------------------------------------------------

class CropzillaTelemetryStore:
    """Stores and retrieves local ESP32 field probe measurements."""

    @staticmethod
    def save_reading(payload: Dict[str, Any]) -> Dict[str, Any]:
        field_id = str(payload.get("field_id", "default_field"))
        device_id = str(payload.get("device_id", "cropzilla_esp32_01"))
        ts = payload.get("timestamp") or datetime.now(timezone.utc).isoformat()

        with sqlite3.connect(DB_PATH) as conn:
            conn.execute(
                """
                INSERT INTO sensor_readings (
                    field_id, device_id, timestamp, soil_moisture_pct,
                    soil_temp_c, soil_ec_ds_m, soil_ph, npk_n_ppm, npk_p_ppm, npk_k_ppm
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    field_id,
                    device_id,
                    ts,
                    payload.get("soil_moisture_pct"),
                    payload.get("soil_temp_c"),
                    payload.get("soil_ec_ds_m"),
                    payload.get("soil_ph"),
                    payload.get("npk_n_ppm"),
                    payload.get("npk_p_ppm"),
                    payload.get("npk_k_ppm"),
                ),
            )
            conn.commit()
        return {"status": "recorded", "field_id": field_id, "device_id": device_id, "timestamp": ts}

    @staticmethod
    def get_latest_reading(field_id: str) -> Optional[Dict[str, Any]]:
        with sqlite3.connect(DB_PATH) as conn:
            conn.row_factory = sqlite3.Row
            cur = conn.execute(
                """
                SELECT * FROM sensor_readings
                WHERE field_id = ?
                ORDER BY id DESC LIMIT 1
                """,
                (field_id,),
            )
            row = cur.fetchone()
            return dict(row) if row else None


