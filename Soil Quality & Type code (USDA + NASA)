@app.route("/api/sensor-ingest", methods=["POST"])
def ingest_cropzilla_sensor():
    """
    Endpoint for Cropzilla.ino (or gateway bridge) to POST field probe readings.
    Expected JSON:
    {
      "field_id": "north_40",
      "device_id": "cropzilla_esp32_01",
      "soil_moisture_pct": 24.5,
      "soil_temp_c": 16.8,
      "soil_ec_ds_m": 1.1,
      "soil_ph": 6.4,
      "npk_n_ppm": 42,
      "npk_p_ppm": 28,
      "npk_k_ppm": 165
    }
    """
    payload = request.get_json(silent=True)
    if not payload:
        return jsonify({"error": "Invalid or missing JSON payload"}), 400
    result = CropzillaTelemetryStore.save_reading(payload)
    return jsonify(result), 201


@app.route("/api/analyze-field", methods=["GET", "POST"])
def analyze_field():
    """
    Main end-to-end pipeline:
    1. Fetches USDA SSURGO soil profile & texture
    2. Fetches USDA CDL historical crop rotation
    3. Fetches NASA POWER agroclimatology & SRTM terrain slope
    4. Merges NASA SMAP/GPM/ECOSTRESS/HLS indicators + Cropzilla ESP32 probe data
    5. Returns ranked crops, explanations, sustainability index, and calendar sprites
    """
    data = request.get_json(silent=True) or {}
    field_id = str(request.args.get("field_id") or data.get("field_id") or "field_alpha")
    try:
        lat = float(request.args.get("lat") if request.args.get("lat") is not None else data.get("lat", 41.8780))
        lon = float(request.args.get("lon") if request.args.get("lon") is not None else data.get("lon", -93.0977))
    except (TypeError, ValueError):
        return jsonify({"error": "lat and lon must be valid numeric coordinates"}), 400

    soil = USDASSURGOClient.fetch_soil_profile(lat, lon)
    crop_history = USDACropHistoryClient.fetch_rotation_history(lat, lon, years=4)
    climate = NASAPOWERClient.fetch_agroclimate(lat, lon, days=30)
    terrain = NASAEarthObservationClient.fetch_terrain_srtm(lat, lon)
    sensor = CropzillaTelemetryStore.get_latest_reading(field_id)
    sat_layers = NASAEarthObservationClient.fetch_satellite_layers_summary(lat, lon, climate, sensor)

    agronomy = AgronomicRecommendationEngine.evaluate_field(
        field_id=field_id,
        lat=lat,
        lon=lon,
        soil=soil,
        crop_history=crop_history,
        climate=climate,
        terrain=terrain,
        sat_layers=sat_layers,
        sensor=sensor,
    )

    return jsonify({
        "field_id": field_id,
        "coordinates": {"lat": lat, "lon": lon},
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "data_provenance_legend": {
            "in_situ_measured": "Direct reading from Cropzilla ESP32 field probe",
            "mapped_survey_database": "USDA NRCS SSURGO soil survey polygon",
            "remotely_sensed_estimate": "NASA/USGS/USDA satellite or gridded reanalysis observation",
            "agronomic_model_prediction": "FieldShift rule-based suitability & sustainability model",
        },
        "in_situ_sensor": {
            "status": "connected" if sensor else "no_recent_telemetry",
            "provenance": "in_situ_measured",
            "latest_reading": sensor,
        },
        "soil_profile": soil,
        "historical_crops": crop_history,
        "climate_and_terrain": {
            "agroclimate": climate,
            "terrain": terrain,
            "satellite_earth_observations": sat_layers,
        },
        "analysis_and_recommendations": agronomy,
    })


@app.route("/api/calendar-sprites/<field_id>", methods=["GET"])
def get_calendar_sprites(field_id: str):
    """Lightweight endpoint specifically for FieldShift_v7_Calendar_Sprite polling."""
    lat = float(request.args.get("lat", 41.8780))
    lon = float(request.args.get("lon", -93.0977))
    soil = USDASSURGOClient.fetch_soil_profile(lat, lon)
    crop_history = USDACropHistoryClient.fetch_rotation_history(lat, lon, years=4)
    climate = NASAPOWERClient.fetch_agroclimate(lat, lon, days=30)
    terrain = NASAEarthObservationClient.fetch_terrain_srtm(lat, lon)
    sensor = CropzillaTelemetryStore.get_latest_reading(field_id)
    sat_layers = NASAEarthObservationClient.fetch_satellite_layers_summary(lat, lon, climate, sensor)
    agronomy = AgronomicRecommendationEngine.evaluate_field(
        field_id, lat, lon, soil, crop_history, climate, terrain, sat_layers, sensor
    )
    return jsonify({
        "field_id": field_id,
        "calendar_sprite_events": agronomy["calendar_sprite_events"],
    })


