class USDACropHistoryClient:
    """Fetches historical crop classification from USDA NASS CropScape CDL."""

    CDL_POINT_URL = "https://nassgeodata.gmu.edu/axis2/services/CDLService/GetCDLValue"

    CDL_CODES = {
        1: "Corn",
        2: "Cotton",
        3: "Rice",
        4: "Sorghum",
        5: "Soybeans",
        6: "Sunflower",
        21: "Barley",
        22: "Durum Wheat",
        23: "Spring Wheat",
        24: "Winter Wheat",
        27: "Rye",
        28: "Oats",
        36: "Alfalfa",
        37: "Other Hay/Non Alfalfa",
        41: "Sugarbeets",
        42: "Dry Beans",
        43: "Potatoes",
        61: "Fallow/Idle Cropland",
        176: "Grass/Pasture",
    }

    @classmethod
    def fetch_rotation_history(cls, lat: float, lon: float, years: int = 4) -> Dict[str, Any]:
        """Queries multi-year CDL pixel values (30m) around the coordinate."""
        current_year = datetime.now(timezone.utc).year - 1
        history: List[Dict[str, Any]] = []

        # Approximate WGS84 to USA Contiguous Albers (EPSG:5070) or pass WGS84 if supported
        # CropScape GetCDLValue expects Albers meters; fallback gracefully if transformation/network fails
        for yr in range(current_year - years + 1, current_year + 1):
            crop_name = cls._query_single_year(lat, lon, yr)
            history.append({"year": yr, "crop": crop_name})

        crops_only = [h["crop"] for h in history if h["crop"] != "Unknown"]
        monoculture_streak = cls._compute_monoculture_streak(crops_only)

        return {
            "history": history,
            "monoculture_streak": monoculture_streak,
            "provenance": tagged_metric(
                crops_only[-1] if crops_only else "Unknown",
                "30m pixel class",
                "USDA NASS Cropland Data Layer (CropScape)",
                "remotely_sensed_estimate",
                "30m x 30m",
                "Satellite-classified annual land cover; field edge pixels may contain mixed signatures.",
            ),
        }

    @classmethod
    def _query_single_year(cls, lat: float, lon: float, year: int) -> str:
        try:
            # Convert WGS84 roughly to CONUS Albers EPSG:5070 for CropScape GetCDLValue
            x_alb, y_alb = cls._wgs84_to_conus_albers(lat, lon)
            params = {"year": year, "x": round(x_alb, 2), "y": round(y_alb, 2)}
            resp = requests.get(cls.CDL_POINT_URL, params=params, timeout=8)
            if resp.status_code == 200 and "<Result>" in resp.text:
                start = resp.text.find("<Result>") + len("<Result>")
                end = resp.text.find("</Result>")
                raw = resp.text[start:end]
                for part in raw.split(","):
                    if "value:" in part:
                        code = int(part.split(":")[1].strip())
                        return cls.CDL_CODES.get(code, f"CDL_Code_{code}")
        except Exception as exc:
            logger.debug("CDL lookup failed for %s: %s", year, exc)
        return "Unknown"

    @staticmethod
    def _wgs84_to_conus_albers(lat: float, lon: float) -> Tuple[float, float]:
        """Standard Albers Equal-Area Conic projection (EPSG:5070) for CONUS."""
        phi = math.radians(lat)
        lam = math.radians(lon)
        phi0 = math.radians(23.0)
        lam0 = math.radians(-96.0)
        phi1 = math.radians(29.5)
        phi2 = math.radians(45.5)
        a = 6378137.0
        e2 = 0.00669438002290

        def q_fn(p: float) -> float:
            sp = math.sin(p)
            return (1 - e2) * (
                sp / (1 - e2 * sp * sp) - (1 / (2 * math.sqrt(e2))) * math.log((1 - math.sqrt(e2) * sp) / (1 + math.sqrt(e2) * sp))
            )

        def m_fn(p: float) -> float:
            sp = math.sin(p)
            return math.cos(p) / math.sqrt(1 - e2 * sp * sp)

        q0, q1, q2, q = q_fn(phi0), q_fn(phi1), q_fn(phi2), q_fn(phi)
        m1, m2 = m_fn(phi1), m_fn(phi2)
        n = (m1 * m1 - m2 * m2) / (q2 - q1)
        c = m1 * m1 + n * q1
        rho0 = a * math.sqrt(c - n * q0) / n
        rho = a * math.sqrt(c - n * q) / n
        theta = n * (lam - lam0)
        return rho * math.sin(theta), rho0 - rho * math.cos(theta)

    @staticmethod
    def _compute_monoculture_streak(crops: List[str]) -> int:
        if not crops:
            return 0
        latest = crops[-1]
        streak = 0
        for c in reversed(crops):
            if c == latest:
                streak += 1
            else:
                break
        return streak


