# 1. USDA NRCS SSURGO Integration (Live Soil Data Access REST API)
# ---------------------------------------------------------------------------

class USDASSURGOClient:
    """Queries USDA NRCS Soil Data Access (SDA) Tabular REST Service."""

    SDA_URL = "https://sdmdataaccess.sc.egov.usda.gov/Tabular/post.rest"

    @classmethod
    def fetch_soil_profile(cls, lat: float, lon: float) -> Dict[str, Any]:
        query = f"""
        SELECT TOP 1
            mu.mukey,
            mu.muname,
            c.compname,
            c.comppct_r,
            c.taxclname,
            c.drainagecl,
            c.hydgrp,
            c.slope_r,
            ch.om_r,
            ch.awc_r,
            ch.sandtotal_r,
            ch.silttotal_r,
            ch.claytotal_r,
            ch.ph1to1h2o_r,
            ch.kwfact
        FROM mapunit mu
        INNER JOIN component c ON c.mukey = mu.mukey AND c.majcompflag = 'Yes'
        INNER JOIN chorizon ch ON ch.cokey = c.cokey AND ch.hzdept_r = 0
        WHERE mu.mukey IN (
            SELECT * FROM SDA_Get_Mukey_from_intersection_with_WktWgs84('point({lon} {lat})')
        )
        ORDER BY c.comppct_r DESC
        """
        try:
            resp = requests.post(
                cls.SDA_URL,
                json={"query": query, "format": "JSON+COLUMNNAME"},
                timeout=HTTP_TIMEOUT,
            )
            resp.raise_for_status()
            payload = resp.json()
            table = payload.get("Table", [])
            if len(table) < 2:
                return cls._fallback_soil(lat, lon, "No SSURGO polygon matched coordinates.")

            headers = table[0]
            row = dict(zip(headers, table[1]))

            sand = float(row.get("sandtotal_r") or 40.0)
            silt = float(row.get("silttotal_r") or 40.0)
            clay = float(row.get("claytotal_r") or 20.0)
            texture_class = cls.classify_usda_texture(sand, silt, clay)

            return {
                "status": "live",
                "mukey": row.get("mukey"),
                "map_unit_name": row.get("muname"),
                "dominant_component": row.get("compname"),
                "taxonomic_class": row.get("taxclname"),
                "texture_class": tagged_metric(
                    texture_class,
                    "USDA class",
                    "USDA NRCS SSURGO",
                    "mapped_survey_database",
                    "1:12,000 - 1:24,000 map unit",
                    "Derived from dominant map-unit surface horizon sand/silt/clay percentages.",
                ),
                "sand_pct": sand,
                "silt_pct": silt,
                "clay_pct": clay,
                "drainage_class": row.get("drainagecl") or "Moderately well drained",
                "hydrologic_group": row.get("hydgrp") or "B",
                "organic_matter_pct": tagged_metric(
                    float(row.get("om_r") or 2.5),
                    "%",
                    "USDA NRCS SSURGO",
                    "mapped_survey_database",
                    "Map unit polygon",
                    "Representative surface horizon organic matter.",
                ),
                "available_water_capacity": tagged_metric(
                    float(row.get("awc_r") or 0.16),
                    "cm/cm",
                    "USDA NRCS SSURGO",
                    "mapped_survey_database",
                    "Map unit polygon",
                    "Available water capacity in top horizon.",
                ),
                "ph": float(row.get("ph1to1h2o_r") or 6.5),
                "erodibility_k_factor": float(row.get("kwfact") or 0.28),
                "ssurgo_slope_pct": float(row.get("slope_r") or 2.0),
            }
        except Exception as exc:
            logger.warning("SSURGO lookup failed (%s); using regional fallback.", exc)
            return cls._fallback_soil(lat, lon, str(exc))

    @staticmethod
    def classify_usda_texture(sand: float, silt: float, clay: float) -> str:
        if clay >= 40:
            if silt >= 40:
                return "Silty Clay"
            if sand >= 45:
                return "Sandy Clay"
            return "Clay"
        if clay >= 27:
            if sand < 20:
                return "Silty Clay Loam"
            if sand >= 45:
                return "Sandy Clay Loam"
            return "Clay Loam"
        if silt >= 80 and clay < 12:
            return "Silt"
        if silt >= 50:
            return "Silt Loam"
        if sand >= 85:
            return "Sand"
        if sand >= 70:
            return "Loamy Sand"
        if sand >= 52:
            return "Sandy Loam"
        return "Loam"

    @staticmethod
    def _fallback_soil(lat: float, lon: float, reason: str) -> Dict[str, Any]:
        return {
            "status": "estimated_fallback",
            "reason": reason,
            "map_unit_name": "Unverified / Outside CONUS SSURGO Coverage",
            "dominant_component": "Regional Loam Proxy",
            "taxonomic_class": "Mollisols / Alfisols Proxy",
            "texture_class": tagged_metric(
                "Loam",
                "USDA class",
                "FieldShift Soil Fallback",
                "agronomic_model_prediction",
                "Regional proxy",
                "SSURGO unavailable at coordinates; verify with local soil sample.",
            ),
            "sand_pct": 40.0,
            "silt_pct": 40.0,
            "clay_pct": 20.0,
            "drainage_class": "Well drained",
            "hydrologic_group": "B",
            "organic_matter_pct": tagged_metric(
                2.4, "%", "Fallback Estimate", "agronomic_model_prediction", "Regional proxy", "Unverified."
            ),
            "available_water_capacity": tagged_metric(
                0.17, "cm/cm", "Fallback Estimate", "agronomic_model_prediction", "Regional proxy", "Unverified."
            ),
            "ph": 6.5,
            "erodibility_k_factor": 0.28,
            "ssurgo_slope_pct": 2.5,
        }


