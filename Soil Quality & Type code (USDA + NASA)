# ---------------------------------------------------------------------------
# Local SQLite Persistence (ESP32 Telemetry & Sustainability Tracking)
# ---------------------------------------------------------------------------

def init_db() -> None:
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS sensor_readings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                field_id TEXT NOT NULL,
                device_id TEXT,
                timestamp TEXT NOT NULL,
                soil_moisture_pct REAL,
                soil_temp_c REAL,
                soil_ec_ds_m REAL,
                soil_ph REAL,
                npk_n_ppm REAL,
                npk_p_ppm REAL,
                npk_k_ppm REAL
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS sustainability_snapshots (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                field_id TEXT NOT NULL,
                recorded_at TEXT NOT NULL,
                sustainability_index REAL NOT NULL,
                organic_matter_score REAL,
                moisture_stability_score REAL,
                erosion_protection_score REAL,
                rotation_diversity_score REAL,
                recommended_crop TEXT
            )
        """)
        conn.commit()


# ---------------------------------------------------------------------------
# Provenance Helper
# ---------------------------------------------------------------------------

def tagged_metric(
    value: Any,
    unit: str,
    source: str,
    provenance_type: str,
    spatial_resolution: str,
    confidence_note: str,
) -> Dict[str, Any]:
    """
    Wraps every data point with explicit provenance so UI layers and farmers
    can distinguish in-situ measurements from coarse satellite estimates or models.
    provenance_type:
      - 'in_situ_measured'
      - 'mapped_survey_database'
      - 'remotely_sensed_estimate'
      - 'agronomic_model_prediction'
    """
    return {
        "value": value,
        "unit": unit,
        "source": source,
        "provenance": provenance_type,
        "spatial_resolution": spatial_resolution,
        "note": confidence_note,
    }


