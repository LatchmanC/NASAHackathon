# Backend secrets (configure via Vercel Project Settings > Environment Variables)
GEMINI_API_KEY=
FIELDSHIFT_GEMINI_MODEL=gemini-3.5-flash-lite
AUTH0_ENABLED=0
AUTH0_ALLOW_SIGNUPS=0  # Set 1 for public Auth0 registrations; verified email required
FIELDSHIFT_DEMO=1
APP_BASE_URL=http://127.0.0.1:8501
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_ALLOWED_EMAILS=
SESSION_SECRET=
# Existing AUTH0_SECRET from Auth0 SDK examples is also supported
# AUTH0_SECRET=
FIELDSHIFT_NWS_USER_AGENT=Cropoganda educational prototype (contact: your-email@example.com)

# Public demo profile (only fictional records; no Gemini)
FIELDSHIFT_SAMPLE_ACCOUNT=0

# Auto-provisioned by the project's private Vercel Blob store:
# BLOB_READ_WRITE_TOKEN=...    # keep private
FIELDSHIFT_MIN_SENSOR_SECONDS=300  # Minimum gap between device uploads; consider 1800 on Hobby

# Set only after running sql/cropoganda_tigerdata.sql in TigerData.
# Use the TLS-enabled connection string from TigerData (never put it in GitHub).
TIGERDATA_DATABASE_URL=
# When TigerData is active, ESP32 uploads may arrive every 2 seconds (higher DB/Vercel usage).
CROPOGANDA_MIN_SENSOR_SECONDS=2

# New independent Google OAuth web client (not Auth0 credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fernet key; set once as a protected Production secret (already set on Vercel).
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Vercel Cron authorization (already set as Production secret).
CRON_SECRET=
